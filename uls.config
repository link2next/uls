uls_ver_major = 1
uls_ver_minor = 13
uls_ver_debug = 0
uls_ver = $(uls_ver_major).$(uls_ver_minor).$(uls_ver_debug)

so_current = 1
so_revision = 1
so_age = 0

TMP_SYSPROPS := $(top_builddir)/ulsconfig/uls_sysprops.txt

ulc2class_exe := $(top_builddir)/tools/ulc2class/ulc2class
ax_ulc2class_exe := ULS_SYSPROPS=$(TMP_SYSPROPS) $(ulc2class_exe)
ax_shell_exe := $(SHELL)

tests_libpath := $(top_builddir)/src/.libs:$(top_builddir)/ulscpp/.libs

